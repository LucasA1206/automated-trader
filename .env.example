# ==============================================================================
# Blitz Trader - Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH REAL VALUES. NEVER COMMIT REAL SECRETS.
# ==============================================================================

# ── Authentication & Security ──────────────────────────────────────────────────
# Required: 64+ char random hex string (generate via: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=your_long_random_jwt_secret_key_here

# Required credentials to authenticate via /api/auth/login
IB_USER=your_ibkr_or_bot_admin_username
IB_PASS=your_strong_admin_password_here

# ── Market Data & AI Providers ────────────────────────────────────────────────
# Required for AI review (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Required for pre-market news & fundamentals (Finnhub: https://finnhub.io/)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Optional: DeepSeek cross-check (DeepSeek platform)
DEEPSEEK_API_KEY=

# Optional: NewsAPI fallback
NEWS_API_KEY=

# ── Broker Connection (IB Gateway) ─────────────────────────────────────────────
IB_HOST=127.0.0.1
IB_PORT=4004
IB_PORT_LIVE=4003

# ── Database ──────────────────────────────────────────────────────────────────
# Production PostgreSQL URL: postgresql://user:pass@host:5432/dbname
# Defaults to sqlite:///./blitz_trader.db if not specified
DATABASE_URL=

# ── Network & CORS ─────────────────────────────────────────────────────────────
# Comma-separated allowed origins (e.g. https://www.blitz-trader.com,https://blitz-trader.vercel.app)
# Wildcards are blocked in authenticated production mode.
ALLOWED_ORIGINS=https://www.blitz-trader.com

# ── Environment & Debug ────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
